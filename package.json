{
  "name": "city-ai-farm",
  "version": "1.0.0",
  "description": "城市AI农场 — 面向城市家庭的智能农业体验平台",
  "main": "electron-main.js",
  "homepage": "./index.html",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:dir": "electron-builder --win --x64 --dir",
    "build:all": "electron-builder --win --x64 --mac --linux",
    "dist": "npm run build",
    "pack": "electron-builder --win --x64 --dir"
  },
  "build": {
    "appId": "com.cityaifarm.app",
    "productName": "城市AI农场",
    "copyright": "Copyright © 2026 城市AI农场",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "electron-main.js",
      "electron-preload.js",
      "index.html",
      "admin-console.html",
      "manifest.json",
      "sw.js",
      "css/**/*",
      "js/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/icon-512x512.png",
      "publisherName": "城市AI农场"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "城市AI农场",
      "artifactName": "${productName}-${version}-安装版.exe"
    },
    "portable": {
      "artifactName": "${productName}-${version}-便携版.exe"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icons/icon-512x512.icns",
      "category": "public.app-category.education",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icons/icon-512x512.png",
      "category": "Education"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0"
  }
}
